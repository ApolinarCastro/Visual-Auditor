# Configuración de Seguridad - Visibility Auditor

# Credenciales del Dashboard (Modificar en el archivo .env real)
DASHBOARD_USER=admin
DASHBOARD_PASS=CHANGE_ME

# Otras configuraciones posibles
# ENVIRONMENT=production
# LOG_LEVEL=INFO

# Adquisicion Paris.cl (Constructor.io)
# La clave NO se versiona. Obtenerla del titular y definirla localmente.
# Sin este valor, Paris se reporta SOURCE_BLOCKED (nunca datos fabricados).
PARIS_CONSTRUCTOR_KEY=
